# ─── Required ──────────────────────────────────────────────────────────────

# MongoDB connection string (MongoDB Atlas free tier works).
# Local: mongodb://127.0.0.1:27017/intervexa
MONGODB_URI=mongodb://127.0.0.1:27017/intervexa

# Auth.js secret used to sign session cookies. Generate one with:
#   npx auth secret     or     openssl rand -base64 32
AUTH_SECRET=

# ─── AI (optional — without it Intervexa runs in demo mode) ─────────────────

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model that supports structured JSON output.
GEMINI_MODEL=gemini-3.6-flash

# ─── Optional: Google sign-in ───────────────────────────────────────────────
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
