# ─── Required ──────────────────────────────────────────────────────────────

# MongoDB connection string (MongoDB Atlas free tier works).
# Local: mongodb://127.0.0.1:27017/intervexa
MONGODB_URI=mongodb://127.0.0.1:27017/intervexa

# Auth.js secret used to sign session cookies. Generate one with:
#   npx auth secret     or     openssl rand -base64 32
AUTH_SECRET=

# Public base URL, used in email links (verification, password reset).
APP_URL=http://localhost:3000

# ─── AI (optional: without any key Intervexa runs in demo mode) ────────────
# Set one or more keys. AI_PROVIDER picks one; otherwise the first configured
# provider is used, in the order gemini → anthropic → openai.
AI_PROVIDER=

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional faster model for per-turn replies (defaults to GEMINI_MODEL).
GEMINI_MODEL_FAST=
# Optional thinking levels (minimal | low | medium | high) for models that support them.
GEMINI_THINKING_FAST=
GEMINI_THINKING_DEEP=

# Anthropic Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MODEL_FAST=
# Effort per tier: low | medium | high (defaults: fast=low, deep=medium).
ANTHROPIC_EFFORT_FAST=
ANTHROPIC_EFFORT_DEEP=

# OpenAI: https://platform.openai.com/api-keys (also used for voice transcription)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MODEL_FAST=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# ─── Optional: Google sign-in ───────────────────────────────────────────────
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Optional: billing (Razorpay) ──────────────────────────────────────────
# Off by default: everyone gets unlimited, full-feature interviews.
BILLING_ENABLED=false
# "simulate" fakes checkout for development/testing when Razorpay keys are unset.
PAYMENTS_MODE=
# https://dashboard.razorpay.com/app/website-app-settings/api-keys (use test keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL: <APP_URL>/api/billing/webhook  (events: payment.captured, order.paid, payment.failed)
RAZORPAY_WEBHOOK_SECRET=

# ─── Optional: email (Resend) ──────────────────────────────────────────────
# Without a key, emails are written to the server log instead of being sent.
RESEND_API_KEY=
EMAIL_FROM=Intervexa <onboarding@resend.dev>

# ─── Optional: security & operations ───────────────────────────────────────
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts resumes at rest.
# If unset, a key is derived from AUTH_SECRET. Don't change it once data exists.
ENCRYPTION_KEY=
# Sentry DSN for error reports (no SDK needed).
SENTRY_DSN=
# debug | info | warn | error
LOG_LEVEL=info
# Set to true only for local load testing / e2e.
RATE_LIMIT_DISABLED=false
# Timezone for streaks and "today".
APP_TIMEZONE=Asia/Kolkata
# Self-host Pyodide (Python coding rounds) instead of the jsDelivr CDN.
NEXT_PUBLIC_PYODIDE_INDEX_URL=
